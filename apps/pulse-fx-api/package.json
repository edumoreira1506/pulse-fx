{
  "name": "@org/pulse-fx-api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "projectType": "application",
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/pulse-fx-api/dist",
          "format": [
            "cjs"
          ],
          "bundle": true,
          "external": ["pg", "pg-native", "typeorm", "reflect-metadata"],
          "main": "apps/pulse-fx-api/src/main.ts",
          "tsConfig": "apps/pulse-fx-api/tsconfig.app.json",
          "assets": [
            "apps/pulse-fx-api/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "keepNames": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "generateLockfile": true,
            "esbuildOptions": {
              "sourcemap": false,
              "keepNames": true,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/pulse-fx-api/dist/package.json",
          "{workspaceRoot}/apps/pulse-fx-api/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/pulse-fx-api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "pulse-fx-api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "pulse-fx-api:build:development"
          },
          "production": {
            "buildTarget": "pulse-fx-api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      },
      "nx-release-publish": {
        "dependsOn": [
          "docker:build"
        ],
        "executor": "@nx/js:release-publish",
        "options": {
          "registry": "https://registry.npmjs.org"
        }
      }
    },
    "tags": [
      "scope:api"
    ],
    "name": "pulse-fx-api"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "express": "^4.21.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
